SECRET_KEY=flood-alert-secret-key-2026
# Local development:
DATABASE_URL=sqlite:///flood_alert.db

# Production (Supabase / PostgreSQL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

TMD_ACCESS_TOKEN=YOUR_PERSONAL_ACCESS_TOKEN
TMD_FORECAST_URL=https://data.tmd.go.th/nwpapi/v1/forecast/location/hourly/place
TMD_TIMEOUT=30
TMD_FORECAST_HOURS=24
TMD_FORECAST_FIELDS=tc,rh,slp,rain,ws10m,wd10m,cond
TMD_MAX_RETRIES=3
TMD_RETRY_BASE_SECONDS=5
TMD_REQUEST_DELAY_SECONDS=2
WEATHER_UPDATE_MINUTES=15

# WeatherWarningNews is published as public XML data.
# Default URL uses the public TMD data catalog example credentials.
TMD_WARNING_URL=https://data.tmd.go.th/api/WeatherWarningNews/v2/?uid=demo&ukey=demokey
TMD_WARNING_TIMEOUT=30
TMD_WARNING_CACHE_MINUTES=10
TMD_WARNING_UPDATE_MINUTES=10
